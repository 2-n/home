#!/usr/bin/env bash

# restore filetype to windows chkdisk files
# since it raped my hdd due to non window filenaming

for file in *; do
  if [ -f "$file" ]; then
    hex_signature=$(xxd -p -l 4 "$file" | head -n 1)
    case "$hex_signature" in
      "49443304") # .mp3
        mv "$file" "${file%.*}.mp3"
        ;;
      "664c6143") # .flac
        mv "$file" "${file%.*}.flac"
        ;;
    esac
  fi
done
