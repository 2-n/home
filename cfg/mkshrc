export EDITOR=micro
export VISUAL=$EDITOR

export QT_QPA_PLATFORMTHEME=qt5ct

export PATH=$HOME/bin:$PATH

export PS1=`echo "\e[36m———\e[0m "`

alias e=$EDITOR
alias c='9 bc -l'
alias calc='c'

alias ls='LC_COLLATE=C ls --group-directories-first --color'
alias lc='ls -A'
alias ll='ls -lAh'

alias mv='mv -iv'
alias rm='rm -iv'

alias mkdir='mkdir -p'

function ,n() {
    case $1 in
        c)  doas nix-collect-garbage -d ;;    
        r)  rm $HOME/.icons/default/index.theme
            doas nixos-rebuild switch --flake $HOME/nix/# ;;
        u)  wd=$PWD
            cd $HOME/nix
            nix flake update
            rm $HOME/.icons/default/index.theme
            doas nixos-rebuild switch --flake $HOME/nix/#
            cd "$wd" && wd=
        ;;
        *)  echo "      ,nix helper script 8)"
            echo "      usage: ,n [c/r/u]"
            echo "          c: collect garbage"
            echo "          r: rebuild switch"
            echo "          u: update flake and rebuild switch"
        ;;
    esac
}
