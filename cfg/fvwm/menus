DestroyMenu rootmenu
AddToMenu   rootmenu
+ "&run"      Exec exec $[infostore.dmenucmd]
+ "" Nop
+ "&acme"     Exec exec $[infostore.9acmecmd]
+ "&terminal" Exec exec $[infostore.terminal]
+ "" Nop
+ "&browser"  Exec exec $[infostore.browscmd]
+ "&music"    Exec exec $[infostore.musiccmd]
+ "&steam"    Exec exec $[infostore.steamcmd] -system-composer
+ "&discord"  Exec exec $[infostore.voicecmd]
+ "&files"    Exec exec $[infostore.filescmd]
+ "&keepass"  Exec exec $[infostore.kpasscmd]
+ "" Nop
+ "options"   Popup rootops

DestroyMenu rootops
AddToMenu   rootops
+ "restart"  Restart
+ "quit"     Module FvwmScript fvwmscript-quit
+ "" Nop
+ "reboot"   Module FvwmScript fvwmscript-reboot
+ "shutdown" Module FvwmScript fvwmscript-shutdown
