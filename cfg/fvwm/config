InfoStoreAdd dmenucmd "drun"
InfoStoreAdd 9acmecmd "acme"
InfoStoreAdd terminal "alacritty msg create-window"
InfoStoreAdd browscmd "firefox"
InfoStoreAdd musiccmd "feishin"
InfoStoreAdd voicecmd "vesktop"
InfoStoreAdd steamcmd "steam"
InfoStoreAdd filescmd "thunar"
InfoStoreAdd kpasscmd "keepassxc"
InfoStoreAdd scrotcmd "shot"

DesktopSize 1x1
EwmhNumberOfDesktops 5 5
EwmhBaseStruts screen $[monitor.primary] 6 6 6 6

Style Alacritty     Sticky
Style firefox       StartsOnDesk 0
Style feishin       StartsOnDesk 1
Style picard        StartsOnDesk 1
Style qbittorrent   StartsOnDesk 1, SkipMapping
Style discord       StartsOnDesk 2
Style vesktop       StartsOnDesk 2
Style steam*        StartsOnDesk 3
Style .gamescope*   StartsOnDesk 4, StaysOnTop
Style PrismLauncher StartsOnDesk 4
Style Minecraft*    StartsOnDesk 4

DefaultFont "xft:SFCompact:size=12"

Colorset 0 bg #404040
Colorset 1 bg #737373
Colorset 2 fg white, bg black, hi #404040, sh #404040
Colorset 3 fg white, bg #1d1d1d

GeometryWindow Hide
OpaqueMoveSize unlimited

BorderStyle -- Flat
Style     * HandleWidth 3, BorderColorset 0, HilightBorderColorset 1

Style     * !Icon, !Title, SloppyFocus, CascadePlacement, \
            ResizeOpaque, SnapAttraction 20 SameType Screen

MenuStyle * MenuColorset 2, ActiveColorset 3, BorderWidth 3, \
            HilightBack, Hilight3DOff, SeparatorsShort, TrianglesSolid, \
            ItemFormat "%|   %l%>   %|", VerticalItemSpacing 2 3

Read binds
Read menus
Read panel

DestroyFunc InitFunction
AddToFunc   InitFunction
+ I Exec exec hsetroot -fill $HOME/.fvwm/bg.jpg
+ I Exec exec qbittorrent
